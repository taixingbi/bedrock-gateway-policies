{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "certified_models.yaml",
  "type": "object",
  "required": ["certified_models"],
  "additionalProperties": false,
  "properties": {
    "certified_models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["quality_score", "safety_score", "p95_latency_ms", "cost_per_request", "certified_at"],
        "additionalProperties": false,
        "properties": {
          "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "safety_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "p95_latency_ms": { "type": "number", "minimum": 0 },
          "cost_per_request": { "type": "number", "minimum": 0 },
          "certified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
